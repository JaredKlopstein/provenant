# Billing variable names only. Never put values in this file or anywhere in
# the repo. Set them in the Vercel project's environment variables (deployed)
# or your own shell (local run). See packages/cloud/src/billing/config.ts.

# Stripe secret or restricted key (sk_test_/rk_test_ while in test mode).
STRIPE_SECRET_KEY=
# "test" by default; "live" only after the manual test-mode check.
PROVENANT_BILLING_MODE=

# Stripe price ids. `provenant-cloud billing sync` prints which goes where.
# Cloud plan, monthly.
STRIPE_PRICE_CLOUD_MONTHLY=
# Cloud plan, annual.
STRIPE_PRICE_CLOUD_ANNUAL=
# Each extra identity on Cloud, monthly.
STRIPE_PRICE_CLOUD_EXTRA_IDENTITY=
# Pay-as-you-go evidence bundle, one-time.
STRIPE_PRICE_BUNDLE_PAYG=
# Overage bundle, metered monthly.
STRIPE_PRICE_BUNDLE_OVERAGE=
