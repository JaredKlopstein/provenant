{
  "name": "provenant-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/**' run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty",
    "lint:boundaries": "node scripts/check-boundaries.mjs",
    "ci": "pnpm run lint:boundaries && pnpm run typecheck && pnpm run test && pnpm run test:offline",
    "test:offline": "vitest run packages/verifier"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
